rules_version = '2';

// ============================================================================
//  Firestore-sikkerhetsregler
// ----------------------------------------------------------------------------
//  Studenter trenger ikke synlig innlogging: appen logger hver nettleser inn
//  ANONYMT (Firebase Auth), og uid-en brukes som stemme-identitet. Reglene
//  håndhever at man kun kan legge til/fjerne SIN EGEN uid i votedUpBy.
//  Lærerhandlinger (godkjenn, avvis, slett, endre grenser) krever innlogging
//  med en godkjent Google-konto.
//
//  KREVER at «Anonymous» er aktivert: Firebase Console → Authentication →
//  Sign-in method → Anonymous → Enable. Uten det feiler stemming/innsending.
//
//  VIKTIG: Denne fila må holdes i synk med det som er PUBLISERT i Firebase
//  Console (Firestore → Rules → Publish). Lærer-e-postene i isTeacher() må
//  matche TEACHER_EMAILS i js/firebase-config.js.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Godkjente lærerkontoer (må matche TEACHER_EMAILS i firebase-config.js)
    function isTeacher() {
      return request.auth != null &&
        request.auth.token.email in [
          "eirik.sorbo@gmail.com"
        ];
    }

    // Typevakt + tak, delt av samlingsreglene (v5.34, audit-funn 9): i
    // regelspråket har både map og liste en size() (antall nøkler/elementer),
    // så et tak uten typevakt kunne omgås ved å sende feltet som et map med
    // ÉN nøkkel som bærer ~1 MB tekst. Manglende felt gir defaulten, som
    // alltid består: feltene er valgfrie.
    function strOk(key, max) {
      return request.resource.data.get(key, "") is string &&
        request.resource.data.get(key, "").size() <= max;
    }
    function listOk(key, max) {
      return request.resource.data.get(key, []) is list &&
        request.resource.data.get(key, []).size() <= max;
    }
    // Årstall o.l. (audit-funn 10): valgfrie (manglende/null er greit), men en
    // satt verdi må være heltall. Uten vakten kunne en ~1 MB streng i f.eks.
    // inventedYear passere hvitelisten, siden feltet ikke hadde noe tak.
    function tallOk(key) {
      return request.resource.data.get(key, null) == null ||
        request.resource.data[key] is int;
    }

    // ---- Forslag (artister) ----
    match /artists/{id} {

      // Stemmelister som mengder, før og etter endringen. get() med default
      // dekker eldre dokumenter som skulle mangle feltet.
      function oldVotes() {
        return resource.data.get("votedUpBy", []).toSet();
      }
      function newVotes() {
        return request.resource.data.votedUpBy.toSet();
      }
      // En gyldig stemme-endring er NØYAKTIG én av:
      //  • legge til sin egen uid (stemme)
      //  • fjerne sin egen uid (angre)
      // Alt annet — andres uid-er, flere om gangen, tømming — avvises.
      function isOwnVoteChange() {
        return request.resource.data.votedUpBy is list && (
          (newVotes().difference(oldVotes()) == [request.auth.uid].toSet() &&
           oldVotes().difference(newVotes()).size() == 0) ||
          (newVotes().difference(oldVotes()).size() == 0 &&
           oldVotes().difference(newVotes()) == [request.auth.uid].toSet())
        );
      }

      // Innholdskrav og størrelsestak for et studentskrevet artistdokument.
      // DELT av create og retur-innsendingen under: hadde de hver sin kopi,
      // ville de drevet fra hverandre (samme lærdom som revisjonen 2026-09-02).
      function artistInnholdOk() {
        return request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 120 &&
          request.resource.data.metaGenre is string &&
          request.resource.data.metaGenre.size() <= 100 &&
          request.resource.data.influenceStart is number &&
          strOk("description", 5000) &&
          strOk("imageUrl", 2000) &&
          strOk("proposedBy", 100) &&
          // Samme tak som pendingEdits-reglene bruker for de samme feltene:
          // uten dem var metaGenre/mainGenre/subGenre/geography/recordLabel
          // ubegrensede strenger/lister her, mens forslags-flyten kappet dem.
          strOk("geography", 200) &&
          strOk("recordLabel", 200) &&
          strOk("instrument", 100) &&
          strOk("gender", 40) &&
          strOk("imageCredit", 300) &&
          listOk("mainGenre", 20) &&
          listOk("subGenre", 20) &&
          listOk("keyWorks", 50) &&
          listOk("musicExamples", 50) &&
          listOk("kilder", 50) &&
          tallOk("birthYear") &&
          tallOk("deathYear") &&
          tallOk("influenceEnd") &&
          tallOk("addedYear");
      }

      // Retur-innsending: studenten retter et forslag læreren har sendt
      // tilbake. Beviset er KODEN (innsendtKode må matche dokumentets
      // returKode, som bare lærer kan sette) — ikke uid, siden studenten kan
      // sitte på en annen enhet enn den som sendte inn. Koden er lesbar for
      // den som leser rått (samlingen er offentlig lesbar), så dette er
      // klasseroms-vern på linje med resten av appen, ikke kryptografi.
      function erReturInnsending() {
        return request.auth != null &&
          resource.data.get("status", "") == "returnert" &&
          resource.data.get("returKode", "") != "" &&
          request.resource.data.get("innsendtKode", "") == resource.data.get("returKode", "") &&
          request.resource.data.status == "pending" &&
          // Typevakt foran taket (audit v5.42 funn 25): som map ville
          // size() gitt 1, og kommentaren kunne båret ~1 MB.
          request.resource.data.get("studentComment", "") is string &&
          request.resource.data.get("studentComment", "").size() <= 1000 &&
          request.resource.data.get("innsendtKode", "").size() <= 12;
      }

      allow read: if true;

      // Studenter (anonymt innlogget) kan sende inn forslag; de opprettes
      // alltid som "pending", uten stemmer og uten lærer-privilegier. Kun
      // kjente felter tillates (hasOnly), og tekst-/listefeltene har typevakt
      // og størrelsestak. NB: taket på en liste teller elementer, ikke hvor
      // store de er, så et dokument kan fortsatt gjøres stort innenfor
      // Firestores grense på 1 MB. Det egentlige vernet mot misbruk utenfor
      // appen er App Check (audit v5.42 funn 25 og forslag 13).
      // Lærer kan opprette uten feltrestriksjoner (import).
      allow create: if isTeacher() || (
        request.auth != null &&
        // Dokument-ID-en havner i data-attributter i lærerens visning. Koden
        // escaper den nå, men Firestore tillater anførselstegn i en ID, og
        // appen selv bruker addDoc (auto-ID) — så et menneskevalgt ID-format
        // her stenger hele klassen ved døren. Samme tegnsett som addDoc gir.
        id.matches("^[A-Za-z0-9_-]{1,64}$") &&
        request.resource.data.keys().hasOnly([
          "name", "birthYear", "deathYear", "gender", "metaGenre", "instrument",
          "mainGenre", "subGenre", "influenceStart", "influenceEnd", "recordLabel",
          "geography", "description", "keyWorks", "musicExamples", "kilder",
          "imageUrl", "imageCredit", "proposedBy", "status", "removedBy",
          "teacherChecked", "priority", "votedUpBy", "addedYear", "createdAt",
          "ownerUid"
        ]) &&
        request.resource.data.status == "pending" &&
        request.resource.data.votedUpBy is list &&
        request.resource.data.votedUpBy.size() == 0 &&
        request.resource.data.get("priority", 0) == 0 &&
        request.resource.data.get("teacherChecked", false) == false &&
        request.resource.data.get("removedBy", null) == null &&
        // createdAt er serverTimestamp() fra klienten; en streng her kunne
        // ellers bære ~1 MB forbi feltmaksene (audit-funn 10).
        request.resource.data.get("createdAt", request.time) is timestamp &&
        // Avsenderens anonyme uid — brukes til at samme nettleser finner igjen
        // sine egne returer. Må være ens egen (eller tom fra eldre klienter).
        request.resource.data.get("ownerUid", "") in ["", request.auth.uid] &&
        artistInnholdOk()
      );

      // Studenter kan endre stemmelista (kun sin egen uid) — eller sende inn
      // på nytt et forslag læreren har sendt tilbake. Retur-innsendingen kan
      // KUN røre innholdsfeltene pluss retur-mekanikken: lærerens felter
      // (teacherFeedback, returKode), stemmer og privilegier står urørlige.
      allow update: if isTeacher() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["votedUpBy"]) &&
        isOwnVoteChange()
      ) || (
        erReturInnsending() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "birthYear", "deathYear", "gender", "metaGenre", "instrument",
          "mainGenre", "subGenre", "influenceStart", "influenceEnd", "recordLabel",
          "geography", "description", "keyWorks", "musicExamples", "kilder",
          "imageUrl", "imageCredit", "proposedBy",
          "status", "innsendtKode", "studentComment"
        ]) &&
        artistInnholdOk()
      );

      allow delete: if isTeacher();
    }

    // ---- Konfigurasjon / grenser ----
    match /config/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- Tiårsbeskrivelser ----
    match /decades/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- Sjangerbeskrivelser (main/sub + story-feltet) ----
    match /genreDescriptions/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- Koblingsbeskrivelser (strekene i slektstreet, doc-ID «fra__til») ----
    match /edgeDescriptions/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- Innhold: sidene «Om historie»/«Røtter» og varmekartet ----
    match /content/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- Podkast-episoder ----
    match /podcasts/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---- Teknologiske innovasjoner ----
    match /tech/{doc} {
      // Innholdskrav og tak for et studentskrevet kort — delt av create og
      // retur-innsendingen, samme grunn som artistInnholdOk over.
      function techInnholdOk() {
        return request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 120 &&
          strOk("description", 5000) &&
          strOk("imageUrl", 2000) &&
          strOk("proposedBy", 100) &&
          // Kilder er en liste med korte strenger — hindrer at feltet brukes til
          // å dytte inn vilkårlig store data via et «forslag».
          listOk("kilder", 20) &&
          // Samme tak som pendingEdits bruker for de samme feltene. Uten dem var
          // ti av femten felter ubegrensede strenger her, mens forslags-flyten
          // kappet dem — et kort opprettet direkte mot REST kunne bære ~1 MB.
          strOk("type", 40) &&
          strOk("category", 100) &&
          strOk("instrument", 100) &&
          strOk("decade", 20) &&
          strOk("adoptedLabel", 300) &&
          strOk("imageCredit", 300) &&
          tallOk("inventedYear") &&
          tallOk("adoptedYear");
      }
      // Se artists: koden er beviset, uid er bare gjenfinning.
      function erReturInnsending() {
        return request.auth != null &&
          resource.data.get("status", "") == "returnert" &&
          resource.data.get("returKode", "") != "" &&
          request.resource.data.get("innsendtKode", "") == resource.data.get("returKode", "") &&
          request.resource.data.status == "pending" &&
          // Typevakt foran taket (audit v5.42 funn 25): som map ville
          // size() gitt 1, og kommentaren kunne båret ~1 MB.
          request.resource.data.get("studentComment", "") is string &&
          request.resource.data.get("studentComment", "").size() <= 1000 &&
          request.resource.data.get("innsendtKode", "").size() <= 12;
      }

      allow read: if true;
      // Studenter (anonymt innlogget) kan foreslå nye innovasjonskort med
      // status:"pending". Lærer kan endre/slette alt og opprette fritt.
      allow create: if isTeacher() || (
        request.auth != null &&
        request.resource.data.keys().hasOnly([
          "name", "type", "category", "instrument", "decade", "inventedYear", "adoptedYear", "adoptedLabel",
          "description", "kilder", "imageUrl", "imageCredit", "proposedBy", "status", "createdAt",
          "ownerUid"
        ]) &&
        request.resource.data.status == "pending" &&
        // Samme vakt som artists-create (audit-funn 10).
        request.resource.data.get("createdAt", request.time) is timestamp &&
        request.resource.data.get("ownerUid", "") in ["", request.auth.uid] &&
        techInnholdOk()
      );
      // Retur-innsending: kun innholdsfeltene + retur-mekanikken kan røres,
      // aldri lærerens felter (teacherFeedback/returKode) eller status utover
      // returnert → pending.
      allow update: if isTeacher() || (
        erReturInnsending() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "type", "category", "instrument", "decade", "inventedYear", "adoptedYear", "adoptedLabel",
          "description", "kilder", "imageUrl", "imageCredit", "proposedBy",
          "status", "innsendtKode", "studentComment"
        ]) &&
        techInnholdOk()
      );
      allow delete: if isTeacher();
    }

    // ---- Endringsforslag (foreslåtte endringer på eksisterende kort) ----
    // Innloggede (anonymt holder) kan opprette forslag. Bare lærer kan
    // endre eller slette.
    match /pendingEdits/{doc} {
      // proposedFields-hjelpere. capOk: feltet er en STRENG innenfor taket;
      // capListOk er listevarianten (tak i ANTALL elementer). Typevakten står
      // foran hvert tak (v5.34, audit-funn 9): map og liste har også size(),
      // så taket alene kunne omgås med et map med én diger nøkkel. Manglende
      // felt gir defaulten, som alltid består. pfTallOk: årstall o.l. er
      // valgfrie, men en satt verdi må være heltall (audit-funn 10).
      function pf() {
        return request.resource.data.proposedFields;
      }
      function capOk(key, max) {
        return pf().get(key, "") is string &&
          pf().get(key, "").size() <= max;
      }
      function capListOk(key, max) {
        return pf().get(key, []) is list &&
          pf().get(key, []).size() <= max;
      }
      function pfTallOk(key) {
        return pf().get(key, null) == null || pf()[key] is int;
      }
      // Validering av selve forslags-feltene, DELT av create og retur-
      // innsendingen: hadde de hver sin kopi, ville de drevet fra hverandre.
      // Størrelsestak per felt (samme vern som artists/tech-create), så ingen
      // kan fylle samlingen med ~1 MB-dokumenter: korte strenger med rause
      // tak, URL som artist-create (2000), beskrivelse 5000, langtekstene
      // (instrumentsammendrag/tiårstekst) 20 000. Lister begrenses i ANTALL —
      // regler kan ikke validere hvert element, så innholdet i kilder-rader
      // dekkes av moderasjonskøen (lærer ser og avviser).
      function forslagOk() {
        return request.resource.data.proposedFields is map &&
        request.resource.data.proposedFields.size() <= 30 &&
        // KUN kjente foreslåbare nøkler: unionen av PROPOSABLE_KEYS i
        // js/proposal-fields.js — HOLD LISTENE I SYNK (nytt foreslåbart felt må
        // inn her, ellers avvises studentforslaget). Uten hvitelisten kunne en
        // vilkårlig nøkkel bære ~1 MB tekst forbi feltmaksene under.
        pf().keys().hasOnly([
          "name", "birthYear", "deathYear", "gender", "metaGenre", "instrument",
          "mainGenre", "subGenre", "influenceStart", "influenceEnd", "recordLabel",
          "geography", "description", "imageUrl", "imageCredit",
          "type", "category", "decade", "inventedYear", "adoptedYear", "adoptedLabel", "kilder",
          "keyWorks", "musicExamples",
          "activeFrom", "activeTo", "era", "body", "society", "tech"
        ]) &&
        capOk("name", 120) &&
        capOk("gender", 40) &&
        capOk("metaGenre", 100) &&
        capOk("instrument", 100) &&
        capOk("recordLabel", 200) &&
        capOk("geography", 200) &&
        capOk("type", 40) &&
        capOk("category", 100) &&
        capOk("decade", 20) &&
        capOk("adoptedLabel", 300) &&
        capOk("era", 100) &&
        capOk("imageCredit", 300) &&
        capOk("imageUrl", 2000) &&
        capOk("description", 5000) &&
        capOk("body", 20000) &&
        capOk("society", 20000) &&
        capOk("tech", 20000) &&
        capListOk("mainGenre", 50) &&
        capListOk("subGenre", 50) &&
        capListOk("kilder", 50) &&
        // Samme tak som artists/create bruker for de samme listene.
        capListOk("keyWorks", 50) &&
        capListOk("musicExamples", 50) &&
        pfTallOk("birthYear") &&
        pfTallOk("deathYear") &&
        pfTallOk("influenceStart") &&
        pfTallOk("influenceEnd") &&
        pfTallOk("inventedYear") &&
        pfTallOk("adoptedYear") &&
        pfTallOk("activeFrom") &&
        pfTallOk("activeTo");
      }
      // Se artists: koden er beviset, uid er bare gjenfinning.
      function erReturInnsending() {
        return request.auth != null &&
          resource.data.get("status", "") == "returnert" &&
          resource.data.get("returKode", "") != "" &&
          request.resource.data.get("innsendtKode", "") == resource.data.get("returKode", "") &&
          request.resource.data.get("status", "") == "open" &&
          request.resource.data.get("studentComment", "") is string &&
          request.resource.data.get("studentComment", "").size() <= 1000 &&
          request.resource.data.get("innsendtKode", "").size() <= 12;
      }

      allow read: if true;
      allow create: if (
        request.auth != null &&
        request.resource.data.keys().hasOnly([
          "entityType", "entityId", "entityName", "proposedFields",
          "proposedBy", "level", "createdAt", "ownerUid"
        ]) &&
        request.resource.data.get("ownerUid", "") in ["", request.auth.uid] &&
        request.resource.data.entityType in ["artist", "tech", "subgenre", "instrument", "decade-society", "decade-tech"] &&
        request.resource.data.entityId is string &&
        request.resource.data.entityId.size() <= 200 &&
        forslagOk() &&
        // level (kun brukt av subgenre-forslag) må være en kjent verdi — hindrer
        // vilkårlige/lange level-strenger. Klienten (approvePendingEdit) godtar
        // dessuten kun main/sub; her tillates også meta som gyldig nivåverdi.
        request.resource.data.get("level", "main") in ["meta", "main", "sub"] &&
        // Typevakter som artists og tech fikk i v5.34 (audit v5.42 funn 25):
        // createdAt er serverTimestamp() fra klienten, og entityName og
        // proposedBy er strenger. Uten dem kunne en streng i createdAt eller et
        // map i entityName/proposedBy bære ~1 MB forbi takene.
        request.resource.data.get("createdAt", request.time) is timestamp &&
        request.resource.data.get("entityName", "") is string &&
        request.resource.data.get("entityName", "").size() <= 200 &&
        request.resource.data.get("proposedBy", "") is string &&
        request.resource.data.get("proposedBy", "").size() <= 100
      );
      // Retur-innsending: forslags-feltene byttes ut, proposedBy og kommentar
      // kan settes, status går returnert → open. Identiteten (entityType/
      // entityId/entityName/level) og lærerens felter kan IKKE røres.
      allow update: if isTeacher() || (
        erReturInnsending() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "proposedFields", "proposedBy", "status", "innsendtKode", "studentComment"
        ]) &&
        request.resource.data.get("proposedBy", "") is string &&
        request.resource.data.get("proposedBy", "").size() <= 100 &&
        forslagOk()
      );
      allow delete: if isTeacher();
    }
  }
}
