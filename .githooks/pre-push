#!/usr/bin/env bash
# ---------------------------------------------------------------------------
#  Pre-push-sjekk. Nekter push hvis:
#    · testene feiler (npm test — ~0,3 s, brutte importer har nådd produksjon
#      som hvit side før)
#    · importgrafen er skitten (tools/check-imports.js) eller det finnes
#      stale referanser (tools/find-stale-refs.js)
#    · en lokal js/css-referanse MANGLER ?v= (nettleseren ser «util.js» og
#      «util.js?v=X» som TO moduler — en blandet graf laster modulen dobbelt,
#      og med genre-modellens live bindings rendrer treet da tomt)
#    · ?v=-referansene ikke matcher VERSION i js/version.js (kjør ./bump.sh)
#  Aktiveres med:  git config core.hooksPath .githooks
# ---------------------------------------------------------------------------
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Testene og verktøyene er raske (<1 s til sammen) og har fanget feilklasser
# som ellers først dukket opp i produksjon.
npm test --silent >/dev/null 2>&1 || { echo "pre-push: npm test feiler. Kjør npm test og se hva."; exit 1; }
node tools/check-imports.js >/dev/null || { echo "pre-push: check-imports feiler. Kjør node tools/check-imports.js."; exit 1; }
node tools/find-stale-refs.js >/dev/null || { echo "pre-push: stale referanser. Kjør node tools/find-stale-refs.js."; exit 1; }

# Cache-busting: ?v= på alle lokale referanser, og i takt med js/version.js.
# Delt med CI (tools/check-versjon.sh), så kroken og GitHub sjekker det samme.
bash tools/check-versjon.sh >/dev/null || { bash tools/check-versjon.sh; exit 1; }

# Glemt versjonsbump: hvis CSS/JS endres i det som pushes, MÅ js/version.js også
# være endret — ellers får studenter med cachet fil gammel kode mot nytt innhold.
# Push-range leses fra stdin (pre-push-protokollen).
z40=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue           # sletting av ref
  if [ "$remote_sha" = "$z40" ]; then
    base=$(git rev-parse --verify -q origin/main || true)
    [ -n "$base" ] && range="$base..$local_sha" || range=""
  else
    range="$remote_sha..$local_sha"
  fi
  [ -n "$range" ] || continue
  changed="$changed"$'\n'"$(git diff --name-only "$range" 2>/dev/null || true)"
done

if printf '%s\n' "$changed" | grep -qE '^(css/.*\.css|js/.*\.js)$'; then
  if ! printf '%s\n' "$changed" | grep -qx "js/version.js"; then
    echo "pre-push: CSS/JS er endret uten at js/version.js er bumpet."
    echo "Bump VERSION i js/version.js og kjør ./bump.sh — ellers får studenter"
    echo "med cachet fil gammel kode mot nytt innhold (stale CSS/JS)."
    exit 1
  fi
fi
